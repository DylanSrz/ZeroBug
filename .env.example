# ── Aplicación ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
APP_PORT=3000

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# En local apunta a localhost (docker compose expone el puerto);
# dentro de Docker, compose sobreescribe DATABASE_HOST=db.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ── Seguridad HTTP ────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por coma. "*" solo en desarrollo;
# en producción el arranque falla si contiene "*".
CORS_ORIGIN=*

# ── Autenticación JWT (Sprint 3, HU-015) ──────────────────────────────────────
# JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas
# JWT_EXPIRES_IN=1h

# ── NestJS Observe (opcional) ─────────────────────────────────────────────────
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=
