# Aplicación
APP_PORT=3000
APP_NODE=development            # development | production | test

# Base de datos (PostgreSQL)
# En local apunta a localhost (docker compose expone el puerto);
# dentro de Docker, compose sobreescribe DATABASE_HOST=db.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# NestJS Observe (opcional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=
